---
import { writtenCurriculum } from '../data/curriculum.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<ol class="fd-chapters">
    {writtenCurriculum.map((section) => (
        <li>
            {section.pages.length > 0
                ? <a href={`${base}/${section.dir}/${section.pages[0][0]}/`}>{section.label}</a>
                : <span class="fd-chapter-soon">{section.label} <small>(coming soon)</small></span>}
            <p>{section.blurb}</p>
        </li>
    ))}
</ol>
